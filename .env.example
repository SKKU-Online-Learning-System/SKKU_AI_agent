# Shared
APP_ENV=local

# PostgreSQL
DATABASE_URL=postgresql+psycopg://course_agent:course_agent@localhost:5432/course_agent

# Alibaba Cloud Model Studio / Qwen
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-27b
# The legacy international endpoints remain supported. For a workspace-specific
# regional endpoint, replace both URLs with the values shown in Model Studio.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=false
QWEN_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# Keep this equal to QWEN_MODEL to run every text-agent capability on Qwen3.8.
QWEN_WEB_SEARCH_MODEL=qwen3.8-27b
USE_MOCK_LLM=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embeddings use the built-in local hash provider (no API key required).

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600
SEED_PASSWORD=password123

# Vector DB
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+psycopg://course_agent:course_agent@localhost:5432/course_agent
VECTOR_DB_COLLECTION=course_document_chunks
VECTOR_DB_EMBEDDING_DIM=1536
VECTOR_SEARCH_MODE=local
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3

# Document processing and retrieval
MOCK_EMBEDDING_DIM=512
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
VECTOR_SEARCH_MODE=local
RAG_TOP_K=5
RAG_MAX_TOP_K=20
# Tuned for the mock provider. Raise to about 0.3 with a real embedding model.
RAG_SCORE_THRESHOLD=0.1

# Answer generation
MAX_QUESTION_LENGTH=2000

# API
BACKEND_CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_UPLOAD_REQUEST_SIZE_BYTES=22020096

# --- COURSE AGENT ----------------------------------------------------------
# Text answers and tool use run on QWEN_MODEL above. Trusted web search uses
# QWEN_WEB_SEARCH_MODEL above (the same Qwen3.8 model by default).
# (or the mock while USE_MOCK_LLM=true). Only hands-free speech-to-speech needs
# xAI; leave XAI_API_KEY blank to keep the mic button disabled.
XAI_API_KEY=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
# Allow one retry when the external WebSocket handshake is temporarily slow.
XAI_CONNECT_TIMEOUT_SECONDS=20
XAI_CONNECT_ATTEMPTS=2
XAI_CONNECT_RETRY_DELAY_SECONDS=0.75
VISUAL_ROUTER_TIMEOUT_SECONDS=3
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE=eve

# Realtime server VAD
VAD_THRESHOLD=0.5
SILENCE_MS=900
PREFIX_MS=300

# --- Weak-concept memory (Moss, https://portal.usemoss.dev) ------------------
# Optional. Without credentials the agent stores weak concepts in
# uploads/voice/weak-concepts.json instead of the cloud index.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_MEMORY_INDEX=course-agent-weak-concepts
MOSS_MEMORY_MODEL=moss-minilm
MOSS_SYNC_DEBOUNCE_SECONDS=0.75
