# Shared
APP_ENV=local

# PostgreSQL
DATABASE_URL=postgresql+psycopg://course_agent:course_agent@localhost:5432/course_agent

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Primary development architecture: all inference is served by the separate
# SKKU_AI_model_server repository. No Qwen model weight is loaded here.
LLM_PROVIDER=local_qwen
USE_MOCK_LLM=false

# Backend.AI에서는 각 preopen port 앱을 공개로 연 뒤 발급된 HTTPS 주소를 사용합니다.
# 예: TEXT_LLM_BASE_URL=https://siriuscluster.skku.edu:102xx/v1
TEXT_LLM_BASE_URL=http://localhost:8001/v1
TEXT_LLM_MODEL=Qwen/Qwen3.8-27B
# 예: VOICE_LLM_BASE_URL=https://siriuscluster.skku.edu:102yy/v1
VOICE_LLM_BASE_URL=http://localhost:8002/v1
VOICE_LLM_MODEL=Qwen/Qwen3.5-9B
VOICE_LLM_MAX_TOKENS=512
MODEL_SERVER_API_KEY=
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_HEALTH_TIMEOUT_SECONDS=2

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# The text model thinks before it answers and the reasoning counts against the
# budget, so the text profile gets its own. 1024 truncated most turns.
TEXT_LLM_MAX_TOKENS=4096
# The 27B is a vision-language model. true sends a student's photo or scanned
# page straight into the message (the model server must keep its vision encoder:
# TEXT_LANGUAGE_MODEL_ONLY=false there); a text-only server falls back to the
# 9B's transcript on its own.
TEXT_LLM_VISION=true
ATTACHMENT_DIRECT_IMAGES_MAX=3
# Korean one-line headlines of the text model's reasoning as it streams, written
# by the fast voice model beside the turn (never gating it). Off = raw text only.
TEXT_THOUGHT_SUMMARIES=true
THOUGHT_SUMMARY_MIN_CHARS=320
THOUGHT_SUMMARY_INTERVAL_SECONDS=4

# Legacy Anthropic regression provider. Only required when
# LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Voice: interruptible local cascade
# ---------------------------------------------------------------------------
VOICE_PROVIDER=local_cascade
# Speak "질문을 살펴보고 있어요..." while the model is still working. It is dropped
# unheard when the reply is ready first, since it delays the answer behind it.
VOICE_SPOKEN_FILLER=true
VOICE_TRACE_CONTENT=false
# Backend.AI에서는 8010 앱의 공개 HTTPS 주소를 두 변수에 동일하게 설정합니다.
# 예: SPEECH_BASE_URL=https://siriuscluster.skku.edu:102zz
SPEECH_BASE_URL=http://localhost:8010
TTS_BASE_URL=http://localhost:8010
ASR_TIMEOUT_SECONDS=30
TTS_TIMEOUT_SECONDS=30
TTS_SPEAKER=ryan
TTS_LANGUAGE=Korean
# Prefer sentence boundaries; unusually long sentences are split near this size.
TTS_CHUNK_MAX_CHARS=80
# Silence re-inserted at the seam between two TTS requests. Each request is
# generated independently and ends on its last speech sample, so without this the
# pause a speaker leaves between sentences disappears. 0 restores gapless output.
TTS_SENTENCE_GAP_MS=180
TTS_CLAUSE_GAP_MS=90

# Application-side Silero VAD / endpointing (PCM16 mono 16 kHz, 20 ms frames)
VAD_THRESHOLD=0.5
MIN_SPEECH_MS=250
SILENCE_MS=900
PREFIX_MS=300

# Legacy Grok regression provider. Only required when VOICE_PROVIDER=grok.
XAI_API_KEY=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_CONNECT_TIMEOUT_SECONDS=20
XAI_CONNECT_ATTEMPTS=2
XAI_CONNECT_RETRY_DELAY_SECONDS=0.75
VISUAL_ROUTER_TIMEOUT_SECONDS=5
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE=eve

# ---------------------------------------------------------------------------
# Trusted web search
# ---------------------------------------------------------------------------
# SearXNG results are filtered again by each course's professor-managed domain
# allowlist before they can become evidence for the LLM.
SEARXNG_URL=http://localhost:8080
SEARXNG_TIMEOUT_SECONDS=10
SEARXNG_MAX_RESULTS=5

# Real multimodal retrieval; mock hashing is opt-in for offline tests only.
EMBEDDING_PROVIDER=qwen
EMBEDDING_BASE_URL=http://localhost:8003/v1
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_DIMENSION=2048
EMBEDDING_TIMEOUT_SECONDS=120
VISION_LLM_BASE_URL=http://localhost:8002/v1
VISION_LLM_MODEL=Qwen/Qwen3.5-9B
DOCUMENT_MAX_PAGES=300
DOCUMENT_RENDER_MAX_SIDE=1600
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=120
RAG_VISUAL_MAX_PAGES=2
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+psycopg://course_agent:course_agent@localhost:5432/course_agent
VECTOR_DB_COLLECTION=course_document_chunks
VECTOR_DB_EMBEDDING_DIM=1536
VECTOR_SEARCH_MODE=local
MOCK_EMBEDDING_DIM=512
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_TOP_K=20
# Calibrate cosine cutoff against your lecture corpus; this is not a probability.
RAG_SCORE_THRESHOLD=0.22
RAG_TEXT_SCORE_THRESHOLD=0.4

# Answer generation
MAX_QUESTION_LENGTH=2000

# Files a student attaches to a typed COURSE AGENT question (images, PDF).
# Read once on the turn that carries them; nothing is indexed. Native PDF text
# is free, a photo or a scanned page costs one vision-model call each.
ATTACHMENT_MAX_COUNT=4
ATTACHMENT_MAX_SIZE_BYTES=52428800
ATTACHMENT_MAX_PAGES=600
# A PDF up to this many pages is read whole; a longer one (a textbook) is indexed
# after upload and each question pulls only the pages that match it.
ATTACHMENT_INLINE_MAX_PAGES=8
ATTACHMENT_INDEX_TOP_K=6
ATTACHMENT_MAX_VISION_PAGES=3
ATTACHMENT_MAX_CHARS=6000
ATTACHMENT_HISTORY_CHARS=2000
# Newest user turns (counting the current one) whose file text the model sees
# in full; older turns keep only the file names. Sized for the 16k-token window.
ATTACHMENT_HISTORY_TURNS=2
# Per-learner storage; the oldest file is evicted to make room.
ATTACHMENT_MAX_STORED_FILES=20
ATTACHMENT_MAX_STORED_BYTES=104857600
ATTACHMENT_READ_TIMEOUT_SECONDS=60

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600
SEED_PASSWORD=password123

# API
BACKEND_CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_UPLOAD_REQUEST_SIZE_BYTES=22020096

# Weak-concept memory (optional Moss). Without credentials the existing local
# JSON fallback remains active.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_MEMORY_INDEX=course-agent-weak-concepts
MOSS_MEMORY_MODEL=moss-minilm
MOSS_SYNC_DEBOUNCE_SECONDS=0.75
