# Backend.AI deployment template
# Copy this file to .env and fill in the PostgreSQL and App Proxy values.

APP_ENV=backendai

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Backend.AI does not run Docker-in-Docker. Point this at a PostgreSQL instance
# reachable from the compute session. pgvector is not required while
# VECTOR_SEARCH_MODE=local because embeddings are stored as JSON and ranked in
# the application process.
DATABASE_URL=postgresql+psycopg://course_agent:CHANGE_ME@DB_HOST:5432/course_agent
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+psycopg://course_agent:CHANGE_ME@DB_HOST:5432/course_agent
VECTOR_DB_COLLECTION=course_document_chunks
VECTOR_DB_EMBEDDING_DIM=1536
VECTOR_SEARCH_MODE=local

# ---------------------------------------------------------------------------
# Local school Model Server in the same Backend.AI session
# ---------------------------------------------------------------------------
LLM_PROVIDER=local_qwen
USE_MOCK_LLM=false
TEXT_LLM_BASE_URL=http://127.0.0.1:8001/v1
TEXT_LLM_MODEL=Qwen/Qwen3.8-27B
VOICE_LLM_BASE_URL=http://127.0.0.1:8002/v1
VOICE_LLM_MODEL=Qwen/Qwen3.5-9B
SPEECH_BASE_URL=http://127.0.0.1:8010
MODEL_SERVER_API_KEY=
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_HEALTH_TIMEOUT_SECONDS=2

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Voice cascade
VOICE_PROVIDER=local_cascade
ASR_TIMEOUT_SECONDS=30
TTS_TIMEOUT_SECONDS=30
TTS_SPEAKER=Sohee
TTS_LANGUAGE=Korean
VAD_THRESHOLD=0.5
MIN_SPEECH_MS=250
SILENCE_MS=900
PREFIX_MS=300

# ---------------------------------------------------------------------------
# Backend.AI application ports / App Proxy
# ---------------------------------------------------------------------------
BACKENDAI_BACKEND_PORT=8000
BACKENDAI_FRONTEND_PORT=3000
BACKENDAI_FRONTEND_MODE=dev
BACKENDAI_SEED=true

# Set these to the URLs that Backend.AI gives to preopen ports 3000 and 8000.
# The startup script warns, but does not block local startup, while placeholders
# remain so you can obtain/configure App Proxy URLs after the processes are up.
NEXT_PUBLIC_API_BASE_URL=https://BACKENDAI_BACKEND_APP_URL
BACKEND_CORS_ORIGINS=https://BACKENDAI_FRONTEND_APP_URL

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# run_backendai.sh replaces this exact placeholder with a cryptographic random
# secret before loading the application, including when you copied this file
# manually with `cp .env.backendai.example .env`.
JWT_SECRET=CHANGE_ME_AUTOGENERATED_BY_RUN_BACKENDAI
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600
SEED_PASSWORD=password123

# ---------------------------------------------------------------------------
# RAG / document processing
# ---------------------------------------------------------------------------
MOCK_EMBEDDING_DIM=512
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_SCORE_THRESHOLD=0.1
MAX_QUESTION_LENGTH=2000

# Keep uploads inside a persistent Backend.AI workspace/vfolder. Change this to
# an absolute mounted vfolder path if your deployment uses one.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_UPLOAD_REQUEST_SIZE_BYTES=22020096

# ---------------------------------------------------------------------------
# Optional trusted web search
# ---------------------------------------------------------------------------
# The app starts without SearXNG; trusted-web tool calls require this endpoint.
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=10
SEARXNG_MAX_RESULTS=5

# ---------------------------------------------------------------------------
# Legacy providers / optional memory
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
XAI_API_KEY=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_CONNECT_TIMEOUT_SECONDS=20
XAI_CONNECT_ATTEMPTS=2
XAI_CONNECT_RETRY_DELAY_SECONDS=0.75
VISUAL_ROUTER_TIMEOUT_SECONDS=3
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE=eve
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_MEMORY_INDEX=course-agent-weak-concepts
MOSS_MEMORY_MODEL=moss-minilm
MOSS_SYNC_DEBOUNCE_SECONDS=0.75
